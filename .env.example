# ==========================================
# 🎼 AI Orchestra v2 - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your keys, or simply run 'python main.py'
# and use the interactive terminal wizard!

# --- Role 1: Searcher Agent (Credible Sources & Research) ---
SEARCH_MODEL=gemini/gemini-3.8-flash
SEARCH_API_KEY=your_search_api_key_here

# --- Role 2: Problem Solver Agent (Soloist / Reasoning) ---
SOLVER_MODEL=gemini/gemini-3.8-flash
SOLVER_API_KEY=your_solver_api_key_here

# --- Role 3: Writer Agent (Master Scribe / Publication Report) ---
WRITER_MODEL=gemini/gemini-3.8-flash
WRITER_API_KEY=your_writer_api_key_here

# --- Provider Environment Fallbacks (Auto-detected if blank) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Web Search API Keys (Optional - Free DuckDuckGo search is used if blank) ---
SERPER_API_KEY=
TAVILY_API_KEY=
